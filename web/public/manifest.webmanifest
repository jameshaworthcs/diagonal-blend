{
  "id": "/",
  "name": "diagonal blend",
  "short_name": "blend",
  "description": "Composite two photos along a seamless diagonal, with one-tap face alignment. Runs entirely on your device.",
  "lang": "en",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#131316",
  "theme_color": "#131316",
  "categories": ["photo", "graphics", "utilities"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "screenshots": [
    { "src": "/screenshots/wide.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "Twin astronauts blended down the middle of the face" },
    { "src": "/screenshots/narrow.png", "sizes": "828x1792", "type": "image/png", "form_factor": "narrow", "label": "The same blend on a phone" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [{ "name": "photos", "accept": ["image/*", ".jpg", ".jpeg", ".png", ".webp", ".avif"] }]
    }
  }
}
